---
import BaseLayout from '../../layouts/Layout.astro';
import { municipios } from '../../data/municipios';
import GraficaHistoricaPoblacion from '../../components/GraficaHistoricaPoblacion.astro';
import GraficaSaldoVegetativo from '../../components/GraficaSaldoVegetativo.astro';
import MunicipiosSection from '../../components/MunicipiosSection.astro';
import DatosDestacados from '../../components/DatosDestacados.astro';
import Kofi from '../../components/Kofi.astro';
import AdBlock from '../../components/AdBlock.astro';
import cifras from '../../data/cifras.json';
import { ANIO_REFERENCIA } from '../../config/anio.js';
import { porcentaje } from '../../scripts/formato.js';

const provincia = 'teruel';
const municipiosTeruel = municipios.filter(m => m.provincia === provincia);

const datos = cifras.provincias[provincia];
const datosTeruel = [
  {
    valor: porcentaje(-datos.variacion1900),
    descripcion: "Disminución de población desde 1900",
    color: "indigo"
  },
  {
    valor: porcentaje(datos.mayorCrecimiento.valor),
    descripcion: `Mayor crecimiento (${datos.mayorCrecimiento.periodo})`,
    color: "emerald"
  },
  {
    valor: porcentaje(-datos.mayorDecrecimiento.valor),
    descripcion: `Mayor decrecimiento (${datos.mayorDecrecimiento.periodo})`,
    color: "amber"
  }
];
---

<BaseLayout title="Teruel - La casa caída">
  <section class="provincia-container">
    <section class="provincia-layout">

      <section class="container-chart">
        <div class="section-text">
          <h1 class="provincia-titulo">Teruel ¿existe?</h1>
          <p class="header-ronda">
            <span class="header-ronda-text">Lagrimas caídas, siglos de exclusión,</span>
            <span class="header-ronda-text">dádivas perdidas en el fondo de un cajón.</span>
            <span class="header-ronda-text">Tierra abandonada para el buitre carroñero,</span>
            <span class="header-ronda-text">promesas olvidadas en el vertedero.</span>
            <span class="header-ronda-text">Somos made in Teruel, made in Teruel,</span>
            <span class="header-ronda-text">estamos que no estamos para mal o para bien.</span>
            <span class="header-ronda-text">Jóvenes parados tienen que partir.</span>
            <span class="header-ronda-text">Viejos resignados sólo les queda vivir viendo como mueren sus raíces</span>
            <a href="https://www.youtube.com/watch?v=Ur3-qy4bd-s" class="header-ronda-text">Azero - Made In Teruel</a>
          </p>

          <section class="intro">
            <p>Teruel existe para aquellos que tuvieron que marchar en busca de un futuro mejor, en aquellos que se quedaron y en aquellos que darían todo por quedarse cuando se acaba el verano. No existe para aquellos que gobernaron, gobiernan y gobernarán. Las cifras son claras: desde {datos.maximo.anio} ha perdido casi la mitad de su población. En {datos.municipiosSinMenores} municipios no hay un solo habitante que sea menor de 16 años. En {datos.municipiosPocosMenores} municipios hay menos de 5 habitantes menores de 16 años.
              El futuro se marcha, obligado por aquellos que pudieron hacer algo y ni tan si quiera lo intentaron.</p>
          </section>

          <Kofi />
          <DatosDestacados datos={datosTeruel} />
        </div>

        <AdBlock slotId="1827851366" format="auto" />

        <div class="chart-header section-text">
          <h2>Evolución de la población - Teruel</h2>
          <p>En la siguiente gráfica podemos ver cómo ha ido evolucionando la población total de la provincia de Teruel desde 1900 hasta {ANIO_REFERENCIA}.</p>
          <span class="data">Los datos provienen de dos fuentes: los censos de 1900 a 2011, disponibles en Aragón Open Data, y el padrón municipal del INE desde 2012 hasta {ANIO_REFERENCIA}.</span>
        </div>
        <GraficaHistoricaPoblacion provincia={provincia} />
      </section>

      <AdBlock slotId="2765328821" format="auto" />

      <section class="container-chart">
        <div class="chart-header section-text">
          <h2>Saldo vegetativo - Teruel</h2>
          <p>El saldo vegetativo representa la diferencia entre nacimientos y defunciones, mostrando el crecimiento natural de la población sin considerar los movimientos migratorios.</p>
          <span class="data">Los datos son del Movimiento Natural de la Población del INE.</span>
        </div>
        <GraficaSaldoVegetativo provincia={provincia} />
      </section>

      <MunicipiosSection municipios={municipiosTeruel} provincia={provincia} />
    </section>
  </section>
</BaseLayout>
